# Nightly home backup: tar incrementals (weekly full) + rsync off-box.
# Script: tools/backup/home-backup.sh, config: ~/.config/home-backup/config
#
# A USER unit (systemctl --user), so LangBang's ⏰ SCHEDULES card can start,
# stop and reschedule it without root. Needs lingering so it runs logged out:
#   sudo loginctl enable-linger $USER
#   cp tools/systemd/home-backup.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now home-backup.timer
# Logs: journalctl --user -u home-backup  (failures also push via LangBang's ntfy topic)
#
# The user manager runs unconfined, so rsync → ssh just works here; as a
# SYSTEM unit, exec'ing rsync transitioned to the confined rsync_t, which may
# not exec ssh (needed SELinuxContext=unconfined_u:unconfined_r:unconfined_t:s0).
[Unit]
Description=Home backup (tar incrementals + rsync off-box)

[Service]
Type=oneshot
WorkingDirectory=%h/projects/LangBang
Environment=PATH=/usr/local/bin:/usr/bin:/usr/sbin
ExecStart=/usr/bin/bash -c 'exec tools/backup/home-backup.sh run'
# background work: never starve the chat app, TTS or the RAG rescan
Nice=15
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
TimeoutStartSec=4h
# 143 = stopped on request (the card's ■ STOP); the script cleaned up
SuccessExitStatus=143
