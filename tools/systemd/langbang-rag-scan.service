[Unit]
Description=LangBang RAG nightly rescan trigger
After=langbang-rag.service
Requires=langbang-rag.service

[Service]
Type=oneshot
User=tyrel
# loopback = authorized; the node runs the walk in its own background thread
ExecStart=/usr/bin/curl -fsS -X POST http://127.0.0.1:8900/api/rescan?windowed=1
