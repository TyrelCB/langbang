+    # [LANGBANG PATCH] Qwen3.8 sometimes skips the parameter tag on tools that
+    # take exactly ONE parameter (seen 5/32 write_todos calls, 0/364 other
+    # calls): "<function=write_todos>\n[{...}]\n</parameter>" or
+    # "<parameter=[{...}]\n</parameter>". Stock parsing discards the bare
+    # value as stray text inside the tool call and emits "{}". When the
+    # function's schema has a single parameter and no parameter was parsed
+    # yet, a bare JSON array/object IS that parameter.
+    def _sole_param(self, func_name: Optional[str], tools: Optional[list[Tool]]) -> Optional[str]:
+        if not func_name:
+            return None
+        props = self._get_arguments_config(func_name, tools)
+        if isinstance(props, dict) and len(props) == 1:
+            return next(iter(props))
+        return None
+
+    def _bare_value_end(self, text: str):
+        """End of a bare (tag-less) value: before </parameter> (consumed) or
+        </function> (left for step 4). None = wait for more text."""
+        cands = []
+        p = text.find(self.parameter_end_token)
+        if p != -1:
+            cands.append((p, len(self.parameter_end_token)))
+        f = text.find(self.function_end_token)
+        if f != -1:
+            cands.append((f, 0))
+        return min(cands) if cands else None
+
