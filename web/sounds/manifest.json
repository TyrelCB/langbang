  "click":             { "file": "TODO-click.ogg",             "when": "button click" },
  "hover":             { "file": "TODO-hover.ogg",             "when": "thread hover" },
  "message_sent":      { "file": "TODO-message-sent.ogg",      "when": "user transmits" },
  "thinking":          { "file": "TODO-thinking-loop.ogg",     "when": "stream start (loop while generating)" },
  "message_received":  { "file": "TODO-message-received.ogg",  "when": "assistant message completes" },
  "tool_start":        { "file": "TODO-tool-start.ogg",        "when": "tool call begins" },
  "tool_end":          { "file": "TODO-tool-end.ogg",          "when": "tool result arrives" },
  "error":             { "file": "TODO-error.ogg",             "when": "backend/stream error" },
  "thread_new":        { "file": "TODO-thread-new.ogg",        "when": "new chat created" },
  "settings_saved":    { "file": "TODO-settings-saved.ogg",    "when": "config saved" }
